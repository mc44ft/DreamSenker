  _dialogueDataArray:
  - SpeakerName: "\u5E74\u8F7B\u9E7F"
    Content: "\u201C\u4F60\u5F88\u773C\u719F\uFF01\u5F88\u50CF\u6211\u68A6\u89C1\u7684\u6E38\u620F\u2026\u2026\u53EB\u300AO\u6D1E\u9A91\u58EB\u300B!\u201D"
    DisplayType: 2
    CanQuickShow: 0
  - SpeakerName: "\u5BFB\u68A6\u8005"
    Content: "\u201C\u5F88\u591A\u4EBA\u90FD\u8FD9\u4E48\u8BF4\u3002\u4F46\u6211\u4E0D\u662F\u4ED6\u3002\u201D"
    DisplayType: 2
    CanQuickShow: 0
  - SpeakerName: "\u5E74\u8F7B\u9E7F"
    Content: "\u201C\u5BF9\u4E86\uFF0C\u4F60\u521A\u4ECE\u4E0A\u9762\u7684\u5730\u65B9\u4E0B\u6765\u5427\uFF1F\u201D"
    DisplayType: 2
    CanQuickShow: 0
  - SpeakerName: "\u5E74\u8F7B\u9E7F"
    Content: "\u201C\u8BF7\u95EE\u2026\u2026\u4F60\u5728\u4E0A\u9762\u6709\u6CA1\u6709\u770B\u5230\u4E00\u4E2A\u6563\u53D1\u7740\u67D4\u548C\u84DD\u5149\uFF0C\u50CF\u6E05\u6668\u9732\u73E0\u4E00\u6837\u7684\u7ED3\u6676\uFF1F\u6211\u4EEC\u53EB\u5B83\u2018\u6668\u9732\u68A6\u6838\u2019\u3002\u201D"
    DisplayType: 2
    CanQuickShow: 0
  - SpeakerName: "\u5BFB\u68A6\u8005"
    Content: "\u201C\u6CA1\u6709\u770B\u5230\u3002\u4E0A\u9762\u9664\u4E86\u5931\u68A6\u8005\uFF0C\u6CA1\u4EC0\u4E48\u7279\u522B\u7684\u4E1C\u897F\u3002\u201D"
    DisplayType: 2
    CanQuickShow: 0
  - SpeakerName: "\u5E74\u8F7B\u9E7F"
    Content: "\u201C\u8FD9\u6837\u554A\u2026\u2026\u5B83\u5BF9\u6211\u6765\u8BF4\u771F\u7684\u5F88\u91CD\u8981\u3002\u90A3\u4E09\u4E2A\u5931\u68A6\u8005\u5B88\u7740\u5B83\uFF0C\u6211\u81EA\u5DF1\u7684\u529B\u91CF\u4E0D\u591F\u2026\u2026\u201D"
    DisplayType: 2
    CanQuickShow: 0
  - SpeakerName: "\u5E74\u8F7B\u9E7F"
    Content: "\u201C\u4F60\u770B\u8D77\u6765\u975E\u5E38\u5389\u5BB3\uFF0C\u80FD\u8BF7\u4F60\u5E2E\u5E2E\u6211\u5417\uFF1F\u5982\u679C\u4F60\u80FD\u627E\u5230\u5E76\u628A\u5B83\u5E26\u7ED9\u6211\uFF0C\u6211\u4E00\u5B9A\u4F1A\u7528\u6700\u597D\u7684\u795D\u798F\u6765\u62A5\u7B54\u4F60\u7684\uFF01"
    DisplayType: 2
    CanQuickShow: 0
