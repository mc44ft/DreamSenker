  _dialogueDataArray:
  - SpeakerName: "\u5E74\u8F7B\u9E7F"
    Content: "\u201C\u4F60\u5F88\u773C\u719F\uFF01\u5F88\u50CF\u6211\u68A6\u89C1\u7684\u6E38\u620F\u2026\u2026\u53EB\u300AO\u6D1E\u9A91\u58EB\u300B!\u201D"
    DisplayType: 2
    CanQuickShow: 0
  - SpeakerName: "\u5E74\u8F7B\u9E7F"
    Content: "\u201C\u521A\u624D\u542C\u5230\u90A3\u8FB9\u597D\u5927\u7684\u52A8\u9759...\u4F60\u6253\u8D25\u4E86\u8718\u86DB\u5417\uFF1F\u201D"
    DisplayType: 2
    CanQuickShow: 0
  - SpeakerName: "\u5931\u68A6\u8005"
    Content: "\"\u55EF\uFF0C\u786E\u5B9E\u8D39\u4E86\u4E0D\u5C11\u529F\u592B\u3002\u5B83\u7684\u86DB\u7F51\u6BD4\u60F3\u8C61\u4E2D\u66F4\u96BE\u5BF9\u4ED8\uFF0C\u4E0D\u8FC7\u603B\u7B97\u89E3\u51B3\u4E86\u3002\""
    DisplayType: 2
    CanQuickShow: 0
  - SpeakerName: "\u5E74\u8F7B\u9E7F"
    Content: "\u201C\u592A\u5389\u5BB3\u4E86\uFF01\u90A3\u4E2A\u5927\u5BB6\u4F19\u56F0\u6270\u6211\u4EEC\u597D\u4E45\u4E86\uFF0C\u4F60\u5C45\u7136\u771F\u7684\u6253\u8D25\u4E86\u5B83\uFF01\u201D"
    DisplayType: 2
    CanQuickShow: 0
  - SpeakerName: "\u5E74\u8F7B\u9E7F"
    Content: "\"\u5176\u5B9E...\u6709\u4EF6\u4E8B\u60F3\u62DC\u6258\u4F60\u3002\u6211\u5728\u4E0A\u65B9\u9057\u843D\u4E86'\u6668\u9732\u68A6\u6838'\uFF0C\u88AB\u4E09\u4F4D\u5931\u68A6\u8005\u770B\u5B88\u7740\u3002\""
    DisplayType: 2
    CanQuickShow: 0
  - SpeakerName: "\u5E74\u8F7B\u9E7F"
    Content: "\"\u4F60\u8EAB\u624B\u8FD9\u4E48\u597D\uFF0C\u80FD\u5E2E\u6211\u53D6\u56DE\u6765\u5417\uFF1F\""
