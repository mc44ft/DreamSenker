  _dialogueDataArray:
  - SpeakerName: "\u65C1\u767D"
    Content: "\uFF08\u4F60\u770B\u7740\u9E7F\u957F\u8001\u53CC\u773C\u8FF7\u79BB\u7684\u6837\u5B50\uFF0C\u4EE5\u8FC5\u96F7\u4E0D\u53CA\u63A9\u8033\u4E4B\u52BF\uFF0C\u5C06\u9E7F\u957F\u8001\u6253\u6655\u4E86\uFF09"
    DisplayType: 2
    CanQuickShow: 1
  - SpeakerName: "\u65C1\u767D"
    Content: "\uFF08\u9E7F\u957F\u8001\u5E94\u58F0\u5012\u5730\uFF0C\u4F60\u770B\u5230\u9E7F\u957F\u8001\u7684\u8EAB\u540E\uFF0C\u7AD9\u7740\u4E00\u4E2A\u4ED9\u98CE\u9053\u9AA8\u7684\u8001\u4EBA\uFF0C\u6B63\u662F\u4F60\u521A\u521A\u51FB\u6740\u7684\u75AF\u8001\u5934\uFF01\uFF09"
    DisplayType: 2
    CanQuickShow: 1
  - SpeakerName: "\u65C1\u767D"
    Content: "\uFF08\u75AF\u8001\u5934\u4E00\u8138\u8BE7\u5F02\uFF0C\u4F3C\u4E4E\u60CA\u8BB6\u4E8E\u4F60\u7684\u4E3E\u52A8\uFF0C\u4E00\u9635\u6C89\u9ED8\u540E\uFF0C\u4ED6\u5F00\u53E3\u4E86\uFF09"
    DisplayType: 2
    CanQuickShow: 1
  - SpeakerName: "\u75AF\u8001\u5934"
    Content: "\u62FF\u6765"
    DisplayType: 2
    CanQuickShow: 1
  - SpeakerName: "\u65C1\u767D"
    Content: "\uFF08\u8FD9\u75AF\u8001\u5934\u7A81\u7136\u53D8\u5F97\u51B7\u51B0\u51B0\u7684\uFF0C\u4F60\u625B\u4E0D\u4F4F\u8FD9\u80A1\u538B\u529B\uFF0C\u53EA\u80FD\u628A\u5305\u88F9\u4EA4\u7ED9\u4E86\u4ED6\uFF09"
    DisplayType: 2
    CanQuickShow: 1
  - SpeakerName: "\u65C1\u767D"
    Content: "\uFF08\u75AF\u8001\u5934\u63A5\u8FC7\u5305\u88F9\uFF0C\u5C06\u94A5\u5319\u6254\u7ED9\u4E86\u4F60\uFF0C\u968F\u540E\u65BD\u5C55\u51FA\u9AD8\u6DF1\u83AB\u6D4B\u7684\u8F7B\u529F\uFF0C\u4E00\u8F6C\u773C\u4E0D\u89C1\u4E86\uFF09"
    DisplayType: 2
    CanQuickShow: 1
  - SpeakerName: "\u65C1\u767D"
    Content: "\uFF08\u770B\u6837\u5B50\uFF0C\u4ED6\u7684\u5B9E\u529B\u4F60\u671B\u5C18\u83AB\u53CA\uFF0C\u521A\u624D\u4E3A\u4EC0\u4E48\u6545\u610F\u653E\u6C34\uFF1F\u4ED6\u53C8\u4E3A\u4EC0\u4E48\u88C5\u50BB\u5145\u6123\uFF1F\u8FD9\u59CB\u7EC8\u4EE4\u4F60\u8FF7\u60D1\u4E0D\u89E3\uFF09"
    DisplayType: 2
    CanQuickShow: 1
