  _title: "\u63A5\u4E0B\u6765"
  _uniqueID: d9fab0bc-ed26-4732-a1df-01ddab045236
  _viewPosition: {x: 1652.4996, y: 24.000053}
  _inputPorts:
  - rid: 1292939278686093350
  _outputPorts:
  - rid: 1292939278686093351
  _dialogueDataArray:
  - SpeakerName: "\u9E7F\u957F\u8001"
    Content: "\u54C8\u54C8\uFF0C\u4F60\u5DF2\u7ECF\u4E2D\u4E86\u6211\u7684\u3010\u9065\u63A7\u6BD2\u7D20\u3011"
    DisplayType: 2
    CanQuickShow: 1
  - SpeakerName: "\u9E7F\u957F\u8001"
    Content: "\u8FD9\u53EF\u662F\u6211\u70BC\u5236\u4E86\u4E5D\u4E5D\u516B\u5341\u4E00\u5929\u7684\u86CA\u4E2D\u4E4B\u738B"
    DisplayType: 2
    CanQuickShow: 1
  - SpeakerName: "\u9E7F\u957F\u8001"
    Content: "\u5C31\u85CF\u5728\u8FD9\u5C0F\u5C0F\u6838\u5FC3\u91CC\uFF0C\u4ECA\u65E9\u4E0D\u614E\u5C06\u5176\u4E22\u6389\u4E86"
    DisplayType: 2
    CanQuickShow: 1
  - SpeakerName: "\u9E7F\u957F\u8001"
    Content: "\u65E2\u7136\u4F60\u4E0D\u77E5\u6B7B\u6D3B\u7684\u5E2E\u6211\u627E\u56DE\u4E86\u5B83\uFF0C\u5C31\u8D4F\u7ED9\u4F60\u4E86\uFF01"
    DisplayType: 2
    CanQuickShow: 1
  - SpeakerName: "\u9E7F\u957F\u8001"
    Content: "\u53EA\u8981\u6211\u60F3\uFF0C\u6211\u968F\u65F6\u53EF\u4EE5\u8BA9\u4F60\u6BD2\u53D1\u8EAB\u4EA1\uFF01"
    DisplayType: 2
    CanQuickShow: 1
  - SpeakerName: "\u9E7F\u957F\u8001"
    Content: "\u6840\u6840\u6840\u6840\u6840\uFF08\u8BE1\u5F02\u7684\u7B11\u58F0\uFF09"
    DisplayType: 2
    CanQuickShow: 1
  - SpeakerName: "\u9E7F\u957F\u8001"
    Content: "\uFF08\u7A81\u7136\u51D1\u8FD1\uFF09\u4F4F\u5728\u4E1C\u8FB9\u7684\u90A3\u4E2A\u75AF\u8001\u5934\uFF0C\u8EAB\u4E0A\u6709\u4E2A\u4E0D\u5F97\u4E86\u7684\u5B9D\u8D1D"
    DisplayType: 2
    CanQuickShow: 1
  - SpeakerName: "\u9E7F\u957F\u8001"
    Content: "\u53BB\u5E2E\u6211\u6740\u4E86\u4ED6\uFF0C\u4E0D\u7136...."
    DisplayType: 2
    CanQuickShow: 1
