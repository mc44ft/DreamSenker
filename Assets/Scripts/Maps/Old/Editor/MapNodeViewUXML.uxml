<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:VisualElement name="Background" style="flex-grow: 1; background-color: rgba(28, 28, 28, 0.8);">
        <ui:VisualElement name="TopContainer" style="flex-grow: 0.01; height: 10px; flex-basis: auto; align-self: auto; width: 500px; flex-direction: row; flex-shrink: 0; min-height: 20px; justify-content: center; align-items: flex-start; background-color: rgba(43, 43, 43, 0.67);" />
        <ui:VisualElement name="MiddleContainer" style="flex-grow: 1; flex-shrink: 2; flex-wrap: nowrap; flex-direction: row;">
            <ui:VisualElement name="LeftContainer" style="flex-grow: 0.01; flex-direction: column; flex-basis: auto; flex-shrink: 0; width: 25px; align-items: flex-start; justify-content: center; background-color: rgba(43, 43, 43, 0.67);" />
            <ui:VisualElement name="DataContainer" style="flex-grow: 1; flex-direction: column; background-color: rgba(43, 43, 43, 0.78); align-items: center; justify-content: flex-start; align-self: auto;" />
            <ui:VisualElement name="RightContainer" style="flex-grow: 0.01; flex-direction: column; flex-shrink: 0; height: auto; width: 25px; justify-content: center; align-items: flex-end; background-color: rgba(43, 43, 43, 0.67);" />
        </ui:VisualElement>
        <ui:VisualElement name="BottomContainer" style="flex-grow: 0.01; flex-direction: row; flex-shrink: 0; height: 20px; justify-content: center; align-items: flex-end; background-color: rgba(43, 43, 43, 0.67);" />
    </ui:VisualElement>
</ui:UXML>
