.mainContainer {
    flex-grow: 0;
    height: 40px;
    flex-direction: row;
    overflow: hidden;
}

.portSlot {
    flex-grow: 0;
    width: 40px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
}

.textField {
    flex-grow: 1;
    flex-shrink: 0;
    min-width: 100px;
    font-size: 25;

    /*允许换行*/
    white-space: normal;
}
