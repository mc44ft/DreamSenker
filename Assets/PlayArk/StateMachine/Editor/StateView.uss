.sm-node #node-background{
    /*相对定位*/
    position: relative;
    justify-content: center;
    align-items: center;
    
}
.sm-node #node-header{
    width: 250px;
    height: 100px;
    /*opacity: 0;*/
}
.sm-node #node-middle{
    display: none;
}
.sm-node Port{
    /*单独恢复其显示方式为初始值*/
    /*display: flex;*/
    
    justify-content: center;
    align-self: center;
    /*绝对定位*/
    position: absolute;
    /*宽高撑满整个header*/
    width: 100%;
    height: 100%;
    /*隐藏该端口*/
    visibility: hidden;
}
.sm-node Port > Label{
    /*隐藏端口文字*/
    display: none;
}
.runningState {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-left-color: rgb(170, 183, 35);
    border-right-color: rgb(170, 183, 35);
    border-top-color: rgb(170, 183, 35);
    border-bottom-color: rgb(170, 183, 35);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
}
